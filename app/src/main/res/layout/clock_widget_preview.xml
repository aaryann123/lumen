<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows: the real widget is a bitmap drawn at runtime, which a preview can't run. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TWELVE 56"
        android:fontFamily="@font/montserrat_heavy"
        android:textSize="30sp"
        android:textColor="#FFFFFF"
        android:shadowColor="#F0000000"
        android:shadowRadius="8" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Have a beautiful\nMonday"
        android:fontFamily="@font/montserrat_regular"
        android:textSize="17sp"
        android:textColor="#FFFFFF"
        android:shadowColor="#F0000000"
        android:shadowRadius="8" />
</LinearLayout>
