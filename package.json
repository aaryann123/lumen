{
  "name": "lumen",
  "private": true,
  "scripts": {
    "dev": "JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@21} ./gradlew :app:installRelease",
    "apk": "JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@21} ./gradlew :app:assembleRelease && cp app/build/outputs/apk/release/app-release.apk Lumen.apk",
